{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "rootDirs": ["."],
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["*.ts", "examples", "src", "test"],
  "exclude": ["dist", "node_modules", "temp", "tmp"]
}
